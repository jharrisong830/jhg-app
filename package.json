{
    "name": "jhg-app",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --hot src/index.ts",
        "build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"'",
        "start": "NODE_ENV=production bun src/index.ts",
        "pretty": "prettier --write .",
        "lint": "eslint ."
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^9.3.1",
        "@mui/material": "^9.3.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router": "^8.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bun": "^1.4.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "eslint": "^10.9.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.4",
        "globals": "^17.11.0",
        "prettier": "^3.9.6",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.67.0"
    }
}
